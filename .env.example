# GitHub OAuth Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App URL (Injected automatically in production, but good to have here for reference)
APP_URL=

# Email Notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Session signing secret. Required — the server refuses to start without it.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
