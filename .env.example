# =====================================================================
# GitFlow Manager — Environment Variables
# Copy this file to .env and fill in your values.
# =====================================================================

# -----------------------------------------------------------------------
# GitHub OAuth App
# Create at: https://github.com/settings/developers → "New OAuth App"
#
#   Application name:          GitFlow Manager (any name)
#   Homepage URL:              http://localhost:3000          <- set APP_URL to match
#   Authorization callback URL: http://localhost:3000/auth/callback
#
# After saving, copy the Client ID and generate a Client Secret below.
# -----------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URL where the app is running.
# For local dev:     http://localhost:3000
# For Docker:        http://localhost:3000  (or your machine IP)
# For Kubernetes:    https://gitflow.example.com
# Must match the "Homepage URL" in your GitHub OAuth App settings.
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------
# Session Secret — random string used to sign session cookies.
# Generate one with: openssl rand -hex 32
# -----------------------------------------------------------------------
SESSION_SECRET=

# -----------------------------------------------------------------------
# Email Notifications (SMTP) — optional
# -----------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------
# Google Gemini AI — optional
# -----------------------------------------------------------------------
GEMINI_API_KEY=
